{
 "about": "Which texts are a kept city (EclipseTracker 2.1.0). The page's parseStoredCity(text, { anyZone: true }) and the app's KeptCity must both give valid for every case; tools/vectors/build-vectors.py checks the list against its own reading. The zone is only checked as text of 1 to 200 characters: the page checks it with the WebView's own zone list. The app also refuses a text over 1,024 characters (KeptCityTest), which the page's rule does not.",
 "cases": [
  {
   "name": "the text the page writes",
   "text": "{\"v\":1,\"name\":\"Bergen\",\"country\":\"Norway\",\"lat\":60.393,\"lon\":5.3242,\"tz\":\"Europe/Oslo\"}",
   "valid": true
  },
  {
   "name": "an unusual zone name is kept as text; the page checks it with the WebView's zone list",
   "text": "{\"v\":1,\"name\":\"Bergen\",\"country\":\"Norway\",\"lat\":60.393,\"lon\":5.3242,\"tz\":\"Mars/Olympus\"}",
   "valid": true
  },
  {
   "name": "the edges: latitude -90, longitude 180, a name of 200 characters",
   "text": "{\"v\":1,\"name\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\"country\":\"Norway\",\"lat\":-90,\"lon\":180,\"tz\":\"Europe/Oslo\"}",
   "valid": true
  },
  {
   "name": "whole numbers for latitude and longitude",
   "text": "{\"v\":1,\"name\":\"Bergen\",\"country\":\"Norway\",\"lat\":60,\"lon\":5,\"tz\":\"Europe/Oslo\"}",
   "valid": true
  },
  {
   "name": "a number written 60.0 is read as 60",
