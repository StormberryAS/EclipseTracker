{
 "about": "What a re-plan does with one stored alarm record (spec section 9.4; core/alarms.js recordFate), made by tools/vectors/build-vectors.py with Python's zoneinfo as the oracle. stage B's Kotlin port must give the same answer for every case. eclipse is the bundled eclipse with the record's eclipseId (null: none); want is {action: arm, fireAt} or {action: delete, reason: invalid | unknown-eclipse | expired | passed}. Instants are UTC, YYYY-MM-DDTHH:MM:SSZ.",
 "graceHours": 48,
 "cases": [
  {
   "name": "C-1: the phone restarts after greatest eclipse (00:13 in Oslo) but before an alarm set for noon that day: the record is armed, not deleted",
   "record": {
    "v": 1,
    "id": "0123456789abcdef0123456789abcdef",
    "eclipseId": "2027-02-20-lunar",
    "spec": {
     "kind": "day",
     "daysBefore": 0,
     "time": "12:00"
    }
   },
   "eclipse": {
    "id": "2027-02-20-lunar",
    "greatest": "2027-02-20T23:12:50Z"
   },
   "zone": "Europe/Oslo",
   "now": "2027-02-21T01:00:00Z",
   "want": {
    "action": "arm",
    "fireAt": "2027-02-21T11:00:00Z"
   }
  },
  {
   "name": "the same alarm at the moment it rings: its time has passed, so the re-plan after the ring deletes it",
   "record": {
    "v": 1,
    "id": "0123456789abcdef0123456789abcdef",
    "eclipseId": "2027-02-20-lunar",
    "spec": {
     "kind": "day",
     "daysBefore": 0,
     "time": "12:00"
    }
   },
   "eclipse": {
    "id": "2027-02-20-lunar",
    "greatest": "2027-02-20T23:12:50Z"
   },
   "zone": "Europe/Oslo",
   "now": "2027-02-21T11:00:00Z",
   "want": {
    "action": "delete",
    "reason": "passed"
   }
  },
  {
